---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Progression from '../components/Progression.tsx';

const exams = await getCollection('exams');

const fmt = (n: number) => `${n} min`;
const base = import.meta.env.BASE_URL;
---

<Layout title="OCP Certif Exam - Accueil">
  <section class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight">Examens disponibles</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">
      Entraînez-vous aux sujets de la certification Java OCP. Choisissez un examen pour commencer.
    </p>
  </section>

  {exams.length === 0 ? (
    <p
      class="rounded-lg border border-dashed border-slate-300 p-8 text-center text-slate-500 dark:border-slate-700 dark:text-slate-400"
    >
      Aucun examen trouvé. Ajoutez des fichiers dans <code>src/content/exams/</code>.
    </p>
  ) : (
    <ul class="grid gap-4 sm:grid-cols-2">
      {exams.map((entry) => {
        const e = entry.data;
        return (
          <li
            class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md dark:border-slate-700 dark:bg-slate-900"
          >
            <div class="flex items-start justify-between gap-2">
              <h2 class="text-lg font-semibold">{e.title}</h2>
              <span
                class="shrink-0 rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium uppercase text-slate-600 dark:bg-slate-800 dark:text-slate-300"
              >
                {e.lang}
              </span>
            </div>
            <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm text-slate-600 dark:text-slate-400">
              <dt>Difficulté</dt>
              <dd class="font-medium text-slate-800 dark:text-slate-200">{e.difficulty}</dd>
              <dt>Durée</dt>
              <dd class="font-medium text-slate-800 dark:text-slate-200">
                {fmt(e.duration_minutes)}
              </dd>
              <dt>Questions</dt>
              <dd class="font-medium text-slate-800 dark:text-slate-200">{e.questions.length}</dd>
            </dl>
            {e.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {e.tags.map((t) => (
                  <span
                    class="rounded bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300"
                  >
                    {t}
                  </span>
                ))}
              </div>
            )}
            <div class="mt-auto pt-4">
              <a
                href={`${base}exam/${entry.id.replace(/\.(md|mdx)$/, '')}`}
                class="inline-block w-full rounded-lg bg-indigo-600 px-4 py-2 text-center text-sm font-semibold text-white transition hover:bg-indigo-700"
              >
                Commencer
              </a>
            </div>
          </li>
        );
      })}
    </ul>
  )}

  <section class="mt-12">
    <Progression client:load />
  </section>
</Layout>