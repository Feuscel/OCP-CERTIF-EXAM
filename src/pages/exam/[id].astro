---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Quiz from '../../components/quiz/Quiz.tsx';
import type { ExamView, QuestionView } from '../../components/quiz/types';

export async function getStaticPaths() {
  const exams = await getCollection('exams');
  return exams.map((entry) => ({
    params: { id: entry.id.replace(/\.(md|mdx)$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const e = entry.data;
const base = import.meta.env.BASE_URL;

const questions: QuestionView[] = e.questions.map((q) => ({
  id: q.id,
  title: q.title,
  type: q.type,
  options: q.options.flatMap((o) =>
    Object.entries(o).map(([label, text]) => ({ label, text }))
  ),
  correctAnswers: q.correct_answers,
  explanationFr: q.explanation_fr,
  explanationEn: q.explanation_en,
}));

const examView: ExamView = {
  id: e.id,
  title: e.title,
  lang: e.lang,
  durationMinutes: e.duration_minutes,
  shuffleQuestions: e.shuffle_questions,
  shuffleOptions: e.shuffle_options,
  difficulty: e.difficulty,
  tags: e.tags,
  questions,
};
---

<Layout title={e.title}>
  <a
    href={base}
    class="mb-4 inline-block text-sm text-indigo-600 hover:underline dark:text-indigo-400"
  >
    &larr; Retour
  </a>
  <Quiz exam={examView} client:load />
</Layout>