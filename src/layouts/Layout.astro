---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.tsx';

interface Props {
  title?: string;
}

const { title = 'OCP Certif Exam' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('ocp.theme.v1');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          if (t === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <header class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
        <a
          href={base}
          class="text-lg font-bold tracking-tight dark:text-slate-100"
        >
          OCP Certif Exam
        </a>
        <div class="flex items-center gap-3">
          <span class="hidden text-sm text-slate-500 sm:inline dark:text-slate-400">
            Java OCP Exam Training
          </span>
          <ThemeToggle client:load />
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-4xl px-4 py-8">
      <slot />
    </main>
    <footer
      class="mx-auto max-w-4xl px-4 py-8 text-center text-sm text-slate-400 dark:text-slate-500"
    >
      &copy; {new Date().getFullYear()} OCP-CERTIF-EXAM
    </footer>
  </body>
</html>